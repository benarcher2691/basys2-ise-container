# syntax=docker/dockerfile:1
#
# ise:14.7-full: Xilinx ISE 14.7 (build 14.7_1015_1), command-line tools.
# Build with docker/build.sh. The ISE files come from
# ise-14.7-ISE_DS.tar, made by docker/extract-from-vm.sh from AMD's
# "ISE 14.7 for Windows 10" VM download. The tar comes in through a named
# build context ("ise") and a bind mount, so it never becomes a layer of
# its own. This image contains AMD software: keep it on this Mac, never
# push it to a registry.

# Ubuntu 14.04 amd64, pinned. Prior art (codepainters/ise14,
# chriz2600/xilinx-ise) found ISE's bundled libraries clash with newer bases.
FROM --platform=linux/amd64 ubuntu:14.04@sha256:881afbae521c910f764f7187dbfbca3cc10c26f8bafa458c76dda009a901c29d

ENV DEBIAN_FRONTEND=noninteractive

# Runtime libraries the ISE binaries link against. Taken from the prior-art
# recipes minus GUI-only ones (libxm4, libxp6), cable ones (libusb) and
# installer-only ones.
# Phase 6 trims this list with strace.
#   libncurses5, libstdc++5       older ISE tools and the installer
#   libglib2.0-0, libsm6, libxi6,
#   libxrender1, libxrandr2,
#   libfreetype6, libfontconfig1,
#   libxtst6                      linked by ISE's shared libraries even when
#                                 run without a display
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libncurses5 libstdc++5 \
      libglib2.0-0 libsm6 libxi6 libxrender1 libxrandr2 \
      libfreetype6 libfontconfig1 libxtst6 \
 && rm -rf /var/lib/apt/lists/*

# Unpack ISE_DS (ISE, common, settings scripts) to where the VM had it.
RUN --mount=type=bind,from=ise,target=/ise \
    mkdir -p /opt/Xilinx/14.7 \
 && tar -xf /ise/ise-14.7-ISE_DS.tar -C /opt/Xilinx/14.7 --no-same-owner \
 && test -x /opt/Xilinx/14.7/ISE_DS/ISE/bin/lin64/par

# FLEXnet's lmutil (licence host ID and diagnostics) wants the old LSB
# loader name.
RUN ln -s /lib64/ld-linux-x86-64.so.2 /lib64/ld-lsb-x86-64.so.3

COPY entrypoint.sh /usr/local/bin/ise-entrypoint

WORKDIR /work
ENTRYPOINT ["/usr/local/bin/ise-entrypoint"]
CMD ["bash"]
